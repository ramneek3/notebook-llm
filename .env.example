# --- Chat model provider (pick ONE by filling its key) ---
# OpenRouter: free models like nvidia/nemotron-3-ultra-550b-a55b:free (50 req/day)
OPENROUTER_API_KEY=
# OpenAI: paid (e.g. CHAT_MODEL=gpt-4o-mini)
OPENAI_API_KEY=

CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Embeddings ---
# "local" = free/offline sentence-transformers; "openai" = OpenAI API
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
